<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.asqi</groupId>
	<artifactId>scholia-kantin-be</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>scholia-kantin-be</name>
	<description>Modul Kantin Cashless SKOOLIA - backend</description>

	<properties>
		<!-- WAJIB 25 - parity admin-be (AGENTS.md §2, ENVIRONMENT.md §1). Jangan 21/26. -->
		<java.version>25</java.version>
		<testcontainers.version>1.21.3</testcontainers.version>
		<!--
			Versi API Docker untuk Testcontainers/docker-java.
			docker-java (Testcontainers 1.21) bernegosiasi versi API lama yang
			DITOLAK Docker Engine 29+ (HTTP 400 → "Could not find a valid Docker
			environment"). Pin ke 1.44 (Docker 25+). Bila mesin memakai Docker
			lebih lama, override: -Ddocker.api.version=1.43
		-->
		<docker.api.version>1.44</docker.api.version>
		<!--
			JaCoCo (issue #174): mengukur cakupan test. Dijalankan pada `verify`
			(prepare-agent di initialize, report di verify) sehingga `./mvnw verify`
			menghasilkan laporan HTML + XML + CSV di target/site/jacoco/.
			Versi 0.8.13 mendukung bytecode Java 25.
		-->
		<jacoco.version>0.8.13</jacoco.version>
	</properties>

	<!-- Testcontainers BOM: Spring Boot 4 tidak lagi mengelola versinya. -->
	<dependencyManagement>
		<dependencies>
			<!--
				WireMock 3.13 (uji kontrak #160) memakai wiremock-jetty12 yang
				dibangun untuk Jetty 12.0.x, sedangkan Spring Boot 4.0.2 mengelola
				Jetty 12.1.5 (menghapus Environment.ensure(String)) →
				NoSuchMethodError saat start. Jetty di sini hanya test-scope
				(runtime web = Tomcat), jadi BOM 12.0.16 diimpor untuk
				menyelaraskannya. Impor di POM ini menang atas versi warisan.
			-->
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-bom</artifactId>
				<version>12.0.16</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.ee10</groupId>
				<artifactId>jetty-ee10-bom</artifactId>
				<version>12.0.16</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- ============================================================ -->
		<!-- WEB (webmvc, BUKAN reactive - AGENTS.md §2)                  -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- ============================================================ -->
		<!-- OBSERVABILITY: Micrometer + Prometheus registry (issue #146)  -->
		<!-- ============================================================ -->
		<!-- Mengekspos /actuator/prometheus agar SLO (tap p95 <= 1 dtk,    -->
		<!-- PRD §12) & alerting bisa dipantau. Versi dikelola BOM         -->
		<!-- micrometer-bom (micrometer.version di spring-boot-dependencies). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- ============================================================ -->
		<!-- API DOCS: springdoc-openapi (OpenAPI 3 + Swagger UI) — #149   -->
		<!-- ============================================================ -->
		<!-- Dokumen API tergenerasi dari kode → mengurangi risiko         -->
		<!-- API-ENDPOINTS.md basi (audit #149). Endpoint: /v3/api-docs &  -->
		<!-- /swagger-ui.html. Versi 3.x WAJIB untuk Spring Boot 4         -->
		<!-- (2.x hanya untuk Boot 3).                                     -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>
		<!-- AOP: dipakai RBAC berbasis anotasi @PerluPeran (security/PeranAspect).
		     ⚠️ Spring Boot 4: artifact lama spring-boot-starter-aop DIHAPUS,
		     diganti spring-boot-starter-aspectj. Jangan pakai nama lama. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- DATABASE: PostgreSQL + Flyway + JPA/JDBC                     -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ============================================================ -->
		<!-- CACHE: Redis (DILARANG cache status blokir kartu - §11.11)   -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- OBJECT STORAGE: MinIO / S3 (nota, foto stok)                 -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>8.5.12</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- EKSPOR LAPORAN: Apache POI (Excel .xlsx, PRD §9.5)           -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.2.3</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- INTEGRASI EKSTERNAL: REST client ke SKOOLIA (JWT RS256)      -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-gson</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- UTIL                                                         -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- ============================================================ -->
		<!-- TEST                                                         -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers PostgreSQL: WAJIB untuk uji ledger & race condition (ADR-0003) -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- ============================================================ -->
		<!-- WIREMOCK: uji kontrak adapter REST integrasi (issue #160)    -->
		<!-- ============================================================ -->
		<!-- Stub HTTP lokal untuk membuktikan adapter memetakan          -->
		<!-- sukses/timeout/5xx/payload salah dengan benar. TIDAK butuh   -->
		<!-- Docker (server embedded) sehingga ikut jalan di `mvn test`.  -->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock</artifactId>
			<version>3.13.1</version>
			<scope>test</scope>
			<exclusions>
				<!--
					WireMock core menarik Jetty 11 (jetty-servlet/servlets/webapp &
					http2-server 11.0.24) sementara Spring Boot 4 memakai Jetty 12.
					Campuran ini memecah runtime ("WriteFlusher$Listener" hilang).
					Jetty 11 di-exclude; wiremock-jetty12 di bawah menyediakan
					implementasi Jetty 12 (jetty-ee10-servlet).
				-->
				<exclusion>
					<groupId>org.eclipse.jetty</groupId>
					<artifactId>jetty-servlet</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.eclipse.jetty</groupId>
					<artifactId>jetty-servlets</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.eclipse.jetty</groupId>
					<artifactId>jetty-webapp</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.eclipse.jetty.http2</groupId>
					<artifactId>http2-server</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!--
			WireMock 3.13 default memakai Jetty 11; proyek ini memakai Jetty 12
			(Spring Boot 4). Modul wiremock-jetty12 menyediakan HttpServerFactory
			untuk Jetty 12 — tanpa ini WireMockServer gagal start
			("Jetty 11 is not present").
		-->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-jetty12</artifactId>
			<version>3.13.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<!--
				Surefire = uji unit cepat (*Test). Failsafe = uji integrasi
				Testcontainers (*IT) yang butuh Docker (ADR-0003, CONVENTIONS §9).
				Dijalankan pada fase `verify` sehingga `mvn verify` menjalankan
				keduanya; `mvn test` hanya unit test (tetap hijau tanpa Docker).

				`api.version` dipatok: docker-java (dipakai Testcontainers 1.21)
				bernegosiasi versi API lama yang DITOLAK Docker Engine 29+
				(HTTP 400 → "Could not find a valid Docker environment").
				Nilai dari properti `docker.api.version` (default 1.44, Docker 25+).
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<api.version>${docker.api.version}</api.version>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!--
						PENTING (issue #174): Failsafe TIDAK memakai argLine JaCoCo
						secara default (berbeda dari Surefire). Set eksplisit ke
						${argLine} (yang diisi jacoco:prepare-agent) agar cakupan
						integration test tergabung ke jacoco.exec. Tanpa ini, IT
						jalan tetapi cakupannya tidak tercatat.
					-->
					<argLine>${argLine}</argLine>
					<systemPropertyVariables>
						<api.version>${docker.api.version}</api.version>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!--
				JaCoCo (issue #174): cakupan test unit (Surefire) + integrasi
				(Failsafe, Testcontainers), digabung ke satu target/jacoco.exec.
				- prepare-agent (initialize): menyetel properti `argLine` ke
				  -javaagent:...jacoco.exec. Surefire memakai `argLine` secara
				  default; Failsafe TIDAK, jadi argLine di-set eksplisit di
				  konfigurasi maven-failsafe-plugin (lihat plugin di atas).
				- report (verify): menulis target/site/jacoco/ (HTML+XML+CSV).
				Tanpa `check` yang menggagalkan build — angka cakupan dicatat
				sebagai artefak & gerbang lunak (lihat docs/uat-dan-dod-rilis.md).
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
