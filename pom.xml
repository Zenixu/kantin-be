<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.asqi</groupId>
	<artifactId>scholia-kantin-be</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>scholia-kantin-be</name>
	<description>Modul Kantin Cashless SKOOLIA - backend</description>

	<properties>
		<!-- WAJIB 25 - parity admin-be (AGENTS.md §2, ENVIRONMENT.md §1). Jangan 21/26. -->
		<java.version>25</java.version>
		<testcontainers.version>1.21.3</testcontainers.version>
		<!--
			Versi API Docker untuk Testcontainers/docker-java.
			docker-java (Testcontainers 1.21) bernegosiasi versi API lama yang
			DITOLAK Docker Engine 29+ (HTTP 400 → "Could not find a valid Docker
			environment"). Pin ke 1.44 (Docker 25+). Bila mesin memakai Docker
			lebih lama, override: -Ddocker.api.version=1.43
		-->
		<docker.api.version>1.44</docker.api.version>
	</properties>

	<!-- Testcontainers BOM: Spring Boot 4 tidak lagi mengelola versinya. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- ============================================================ -->
		<!-- WEB (webmvc, BUKAN reactive - AGENTS.md §2)                  -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- AOP: dipakai RBAC berbasis anotasi @PerluPeran (security/PeranAspect).
		     ⚠️ Spring Boot 4: artifact lama spring-boot-starter-aop DIHAPUS,
		     diganti spring-boot-starter-aspectj. Jangan pakai nama lama. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- DATABASE: PostgreSQL + Flyway + JPA/JDBC                     -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ============================================================ -->
		<!-- CACHE: Redis (DILARANG cache status blokir kartu - §11.11)   -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- OBJECT STORAGE: MinIO / S3 (nota, foto stok)                 -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>8.5.12</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- INTEGRASI EKSTERNAL: REST client ke SKOOLIA (JWT RS256)      -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-gson</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- UTIL                                                         -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- ============================================================ -->
		<!-- TEST                                                         -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers PostgreSQL: WAJIB untuk uji ledger & race condition (ADR-0003) -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<!--
				Surefire = uji unit cepat (*Test). Failsafe = uji integrasi
				Testcontainers (*IT) yang butuh Docker (ADR-0003, CONVENTIONS §9).
				Dijalankan pada fase `verify` sehingga `mvn verify` menjalankan
				keduanya; `mvn test` hanya unit test (tetap hijau tanpa Docker).

				`api.version` dipatok: docker-java (dipakai Testcontainers 1.21)
				bernegosiasi versi API lama yang DITOLAK Docker Engine 29+
				(HTTP 400 → "Could not find a valid Docker environment").
				Nilai dari properti `docker.api.version` (default 1.44, Docker 25+).
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<api.version>${docker.api.version}</api.version>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<api.version>${docker.api.version}</api.version>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
