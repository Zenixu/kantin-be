# ============================================================
# .env.example — TEMPLATE variabel lingkungan kantin-be (issue #149)
# ------------------------------------------------------------
# Cara pakai:
#   cp .env.example .env      # lalu isi nilai <GANTI_...>
#   docker compose --env-file .env up -d
#   # atau export manual untuk `./mvnw spring-boot:run`
#
# ⚠️  .env sudah di-.gitignore. JANGAN commit nilai asli (kredensial).
#     Untuk konfigurasi lokal via properties, lihat
#     src/main/resources/application-local.properties.example.
#
# Semua nilai di bawah punya default aman di application.properties;
# isi hanya yang perlu di-override. Nama variabel = ${...} di properties.
# ============================================================

# --- Profil Spring ---
# local = pengembangan (default). JANGAN pakai local di staging/produksi.
SPRING_PROFILES_ACTIVE=local

# --- Database: PostgreSQL (docker compose up -d) ---
DB_URL=jdbc:postgresql://localhost:5432/kantin_db?stringtype=unspecified
DB_USERNAME=kantin
DB_PASSWORD=<GANTI_DB_PASSWORD>

# --- Redis (docker compose up -d) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Aktifkan health check Redis di staging/produksi (dev: biarkan false).
REDIS_HEALTH_ENABLED=false
REDIS_TIMEOUT=2s

# --- MinIO / S3 (nota, foto stok; opsional di lokal) ---
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=<GANTI_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<GANTI_MINIO_SECRET_KEY>
MINIO_BUCKET=kantin
MINIO_URL_FINAL=http://localhost:9000/kantin/

# --- JWT RS256: public key penerbit (base64 X.509 DER) ---
# ⛔ BLOCKING Q1/Q2: minta ke admin-be (staf) & mobile-be (ortu). Lihat #44.
JWT_ADMIN_PUBLIC_KEY=
JWT_MOBILE_PUBLIC_KEY=
JWT_ISSUER_ADMIN=skoolia-admin
JWT_ISSUER_MOBILE=skoolia-mobile
JWT_VERIFY_ISSUER=true
JWT_COOKIENAME=skoolia-cookies

# --- SHIM LOGIN DEV (HANYA lokal) ---
# Aman untuk produksi: default false. Hanya hidup di profil "local".
KANTIN_DEV_LOGIN_ENABLED=false
KANTIN_DEV_LOGIN_ISSUER=skoolia-admin
KANTIN_DEV_LOGIN_TTL_MS=43200000
# Private key RSA base64 PKCS#8 DER — pasangan JWT_ADMIN_PUBLIC_KEY.
KANTIN_DEV_LOGIN_PRIVATE_KEY=

# --- CORS: origin FE yang diizinkan (dipisah koma, TANPA "*") ---
KANTIN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Integrasi SKOOLIA (REST internal) ---
SKOOLIA_ADMIN_BE_URL=http://localhost:8081
SKOOLIA_MOBILE_BE_URL=
SKOOLIA_INTERNAL_BE_URL=
SKOOLIA_CALLBACK_BE_URL=

# --- Webhook masuk: HMAC-SHA256 (SECURITY.md §5.1) ---
# WAJIB diisi sebelum /api/webhook/** dipakai; kosong → endpoint 503.
KANTIN_WEBHOOK_SECRET=<GANTI_WEBHOOK_SECRET>
KANTIN_WEBHOOK_TOLERANCE_SECONDS=300
KANTIN_WEBHOOK_ALLOWED_IPS=
KANTIN_WEBHOOK_TRUSTED_PROXIES=

# --- API internal (dipakai admin-be): signature HMAC ---
KANTIN_INTERNAL_ENABLED=false
KANTIN_INTERNAL_SECRET=
KANTIN_INTERNAL_ALLOWED_IPS=
KANTIN_INTERNAL_TRUSTED_PROXIES=
KANTIN_INTERNAL_TOLERANCE_SECONDS=300

# --- Rate limit (SECURITY.md §7) ---
KANTIN_RATE_LIMIT_ENABLED=true
KANTIN_RATE_LIMIT_WINDOW=60
KANTIN_RATE_LIMIT_AUTH=20
KANTIN_RATE_LIMIT_SENSITIVE=60
KANTIN_RATE_LIMIT_DEFAULT=600
# fail-open (false) = bila Redis mati, request tetap dilayani (kantin jalan).
KANTIN_RATE_LIMIT_FAIL_CLOSED=false
KANTIN_RATE_LIMIT_TRUSTED_PROXIES=

# --- Aktivasi modul kantin (PRD §10, Q6) ---
KANTIN_AKTIVASI_MODUL_ENABLED=true
KANTIN_AKTIVASI_MODUL_CACHE_SECONDS=60

# --- Observability (issue #146) ---
KANTIN_METRICS_PUBLIC=true

# --- Dokumentasi API: springdoc/OpenAPI (issue #149) ---
# true (default) = /v3/api-docs & /swagger-ui.html dapat diakses tanpa token.
KANTIN_OPENAPI_PUBLIC=true

# --- Penjadwal (scheduler) ---
KANTIN_SCHEDULER_RETRY_POSTING_ENABLED=true
KANTIN_SCHEDULER_JAM_TUTUP_ENABLED=true
KANTIN_SCHEDULER_SESI_ENABLED=true

# --- Notifikasi (mobile-be, Q5) ---
KANTIN_NOTIFIKASI_ENABLED=false
KANTIN_NOTIFIKASI_BASE_URL=
KANTIN_NOTIFIKASI_TIMEOUT_MS=2000

# --- Penjaga topologi DB (ADR-0010) ---
KANTIN_TOPOLOGI_ENFORCE=false
KANTIN_TOPOLOGI_HOST_DB_ADMIN_BE=
KANTIN_TOPOLOGI_DB_DILARANG=
